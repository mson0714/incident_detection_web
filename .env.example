APP_NAME=Airscope
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=urban_observatory
DB_USERNAME=urban
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

URBAN_MODE=synthetic
URBAN_CITY="Ho Chi Minh City"
URBAN_TIMEZONE=Asia/Ho_Chi_Minh
URBAN_THRESHOLD=35
URBAN_COOLDOWN_HOURS=6
URBAN_FRESHNESS_MINUTES=90
URBAN_FORECAST_FRESHNESS_MINUTES=90
URBAN_PM25_MAX=500
URBAN_RULE_VERSION=pm25-two-consecutive-v1

# Private worker API. Empty disables the new protected flood endpoints.
FLOOD_API_TOKEN=
